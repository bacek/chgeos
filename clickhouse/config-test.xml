<clickhouse>
    <allow_experimental_webassembly_udf>true</allow_experimental_webassembly_udf>
    <webassembly_udf_engine>wasmtime</webassembly_udf_engine>
    <tcp_port>19000</tcp_port>
    <http_port>18123</http_port>
   <path>__DATA_DIR__</path>
    <user_files_path>__USER_FILES_PATH__</user_files_path>
    <!--
      <max_server_memory_usage_to_ram_ratio>0.25</max_server_memory_usage_to_ram_ratio>
    -->
    <max_server_memory_usage>30G</max_server_memory_usage>
    <logger>
      <console>true</console>
    </logger>
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
    </query_log>
    <query_thread_log>
        <database>system</database>
        <table>query_thread_log</table>
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
    </query_thread_log>
    <!-- Sampling profiler output. Enabled because perf cannot attach to the
         server in this sandbox (perf_event_open on another pid yields no
         samples), and system.trace_log is the only way left to see where query
         CPU time goes. Sampling is off per query until a query_profiler_*_period
         setting is set, so this costs nothing by default. -->
    <trace_log>
        <database>system</database>
        <table>trace_log</table>
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
    </trace_log>
    <!-- Per-processor elapsed/wait timings. Off in the default profile so
         benchmarks don't pay for it; opt in per query with
         SETTINGS log_processors_profiles=1. -->
    <processors_profile_log>
        <database>system</database>
        <table>processors_profile_log</table>
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
    </processors_profile_log>
    <users>
        <default>
            <password></password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </default>
    </users>
    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
    <profiles>
        <default>
            <!-- query-level setting (alias of allow_experimental_database_iceberg);
                 must live in a profile, not at the top level -->
            <allow_database_iceberg>true</allow_database_iceberg>
            <webassembly_udf_max_fuel>0</webassembly_udf_max_fuel>
            <webassembly_udf_max_memory>1073741824</webassembly_udf_max_memory>
            <allow_experimental_column_binary_format>1</allow_experimental_column_binary_format>
            <log_processors_profiles>0</log_processors_profiles>
        </default>
    </profiles>
</clickhouse>
